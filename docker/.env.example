# Copy this file to docker/.env and fill it in. Do not commit docker/.env.

# Optional. The app is served on port 3000 and calls the API at /api on the same address,
# so it works from any machine that can reach this one. Set these only to serve the API
# from a different address: API_URL is where browsers reach it, and FRONTEND_URL is where
# people open the app, which the API then accepts requests from.
# FRONTEND_URL=https://app.example.com
# API_URL=https://api.example.com/api

POSTGRES_PASSWORD=

# WorkOS AuthKit: the client ID of the WorkOS environment people sign in with.
WORKOS_CLIENT_ID=
# Optional. Lets people delete their account from Settings, sign-in included.
WORKOS_API_KEY=

# Plaid: PLAID_ENV is sandbox or production; PLAID_SECRET is the secret for that environment.
PLAID_CLIENT_ID=
PLAID_ENV=sandbox
PLAID_SECRET=

# Optional. Encrypts Plaid's access tokens. Left empty, the server generates one on first
# start and keeps it in the server-data volume. To manage it yourself, see
# ../docs/plaid-token-encryption.md and paste the JSON on one line, in single quotes.
PLAID_TOKEN_ENCRYPTION_KEYSET=

# Optional. The server syncs every linked bank every few hours. For new transactions within
# minutes, ngrok gives Plaid a public URL for its webhooks: uncomment COMPOSE_PROFILES and
# copy your authtoken and free static domain (without https://) from
# https://dashboard.ngrok.com. Plaid saves the webhook URL on each account when it's
# linked, so set this up before linking accounts and keep the same domain.
# COMPOSE_PROFILES=webhooks
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# TypeSafe API key for Jev, which sorts transactions into buckets, guesses recurring
# payments and puts bills on plan lines. Without it the app runs, but none of that happens.
# Get one at https://docs.typesafe.ai.
TYPESAFE_API_KEY=

# Optional. PrimeUI license key.
PRIMEUI_LICENSE_KEY=

# Copy this file to docker/.env and fill it in. Do not commit docker/.env.

# Optional. The app is served on port 3000 and calls the API at /api on the same address,
# so it works from any machine that can reach this one. Set these only to serve the API
# from a different address: API_URL is where browsers reach it, and FRONTEND_URL is where
# people open the app, which the API then accepts requests from.
# FRONTEND_URL=https://app.example.com
# API_URL=https://api.example.com/api

POSTGRES_PASSWORD=

# Clerk: use the publishable key and Frontend API URL from the same Clerk application.
CLERK_PUBLISHABLE_KEY=
CLERK_FRONTEND_API_URL=

# Plaid: PLAID_ENV is sandbox or production; PLAID_SECRET is the secret for that environment.
PLAID_CLIENT_ID=
PLAID_ENV=sandbox
PLAID_SECRET=

# Generate a keyset; see ../docs/plaid-token-encryption.md. Paste the JSON on one line,
# in single quotes.
PLAID_TOKEN_ENCRYPTION_KEYSET=

# ngrok gives Plaid a public URL for its webhooks, which keep transactions syncing after
# accounts are linked. Copy your authtoken and free static domain (without https://) from
# https://dashboard.ngrok.com. Plaid saves the webhook URL on each account when it's
# linked, so keep the same domain.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# TypeSafe API key for Jev, which sorts transactions into buckets, guesses recurring
# payments and puts bills on plan lines. Without it the app runs, but none of that happens.
# Get one at https://docs.typesafe.ai.
TYPESAFE_API_KEY=

# Optional. PrimeUI license key.
PRIMEUI_LICENSE_KEY=
